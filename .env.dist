# Documentation available in docs/reference/environment-variables.md
#

# Database connection
# The MYSQL_* names are still accepted as a fallback.
DB_DRIVER=mysql
DB_HOST=db
DB_NAME=mailserver
DB_PASSWORD=changeme
DB_PORT=3306
# Doctrine cannot auto-detect the PostgreSQL server version in this image.
DB_SERVER_VERSION=8.4
DB_USER=mailserver

# Only used by the bundled database container
DB_ROOT_PASSWORD=changeme

# Redis credentials
REDIS_HOST=redis
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# Mailserver administrative identity
MAILNAME=mail.example.com
POSTMASTER=postmaster@example.com

# Relay mails to another SMTP server
# @see docs/how-to/configure-relayhost.md
RELAYHOST=false
RELAY_PASSWD_FILE=false

# Block suspicious attachments by type (bat, com, exe, dll, vbs, docm, doc, dzip)
FILTER_MIME=false

# Password to access the rspamd web-interface
CONTROLLER_PASSWORD=changeme2

# Password to access the dovecot doveadm api
DOVEADM_API_KEY=changeme2

# How long to wait for services to start
WAITSTART_TIMEOUT=2m

# Configure local address extension
# Check the documentation for more information.
RECIPIENT_DELIMITER=-

# Interval in seconds for fetchmail to check for new mails
FETCHMAIL_INTERVAL=300

# Expects the PROXY protocol on imap(s) and pop3(s) ports
# Check the documentation for more information.
MDA_UPSTREAM_PROXY=false

# Expects the PROXY protocol on smtp and submission ports
# Check the documentation for more information.
MTA_UPSTREAM_PROXY=false

# MCP endpoint for agents, off by default
# @see docs/how-to/configure-mcp-server.md
# The hostnames clients use, comma-separated and without a port. A reverse proxy has to preserve Host.
MCP_ALLOWED_HOSTS=mail.example.com
MCP_ENABLED=false
# Default and maximum lifetime of an API token, in days.
# MCP_TOKEN_MAX_LIFETIME_DAYS=90

# Read and send mail through MCP. Both need a docker-mailserver with the mailbox_credentials passdb.
MCP_MAIL_READ_ENABLED=false
MCP_MAIL_SEND_ENABLED=false

# Parallel IMAP sessions per user. Dovecot allows 10 per user and address, shared with Roundcube.
MCP_MAIL_MAX_IMAP_SESSIONS=5
# Size limit of the body message_get returns, in bytes.
MCP_MAIL_MESSAGE_MAX_BYTES=65536
# Client timeouts in seconds. An auth penalty delays a login by up to 15 seconds.
MDA_IMAP_TIMEOUT_SECONDS=25
MTA_SMTP_TIMEOUT_SECONDS=25

# Limits of message_send. Postfix allows 20 connections per minute per client address, shared with Roundcube.
MCP_MAIL_SEND_GLOBAL_LIMIT_PER_MINUTE=15
MCP_MAIL_SEND_MAX_BYTES=1048576
MCP_MAIL_SEND_MAX_RECIPIENTS=20
# MCP_MAIL_SEND_TOKEN_LIMIT_PER_HOUR=30
MCP_MAIL_SEND_USER_LIMIT_PER_HOUR=60
