{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubernetes Security Context Validation Schema",
  "description": "Schema to ensure all Pods and Containers have securityContext specified",
  "type": "object",
  "$defs": {
    "container": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "securityContext": {
          "type": "object",
          "description": "Container-level security context is required",
          "properties": {
            "capabilities": {
              "type": "object",
              "description": "Linux capabilities have to be set explicitly",
              "properties": {
                "drop": {
                  "type": "array",
                  "description": "Drop every capability and re-add only the ones the container needs",
                  "contains": {
                    "const": "ALL"
                  }
                }
              },
              "required": ["drop"]
            }
          },
          "required": ["capabilities"]
        }
      },
      "required": ["name", "securityContext"]
    },
    "podSpec": {
      "type": "object",
      "properties": {
        "securityContext": {
          "type": "object",
          "description": "Pod-level security context is required"
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/container"
          }
        },
        "initContainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container"
          }
        }
      },
      "required": ["securityContext", "containers"]
    }
  },
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Pod",
        "Deployment",
        "StatefulSet",
        "DaemonSet",
        "Job",
        "CronJob"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "properties": {
        "template": {
          "type": "object",
          "properties": {
            "spec": {
              "$ref": "#/$defs/podSpec"
            }
          },
          "required": ["spec"]
        }
      },
      "required": ["template"]
    }
  },
  "required": ["apiVersion", "kind", "spec"],
  "if": {
    "properties": {
      "kind": {
        "const": "Pod"
      }
    }
  },
  "then": {
    "properties": {
      "spec": {
        "$ref": "#/$defs/podSpec"
      }
    }
  }
}
