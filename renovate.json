{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekends",
    ":approveMajorUpdates",
    "group:recommended",
    ":automergeMinor",
    ":automergePatch",
    ":automergeDigest",
    ":automergePr",
    ":docker",
    ":semanticCommits",
    ":label(renovate)"
  ],
  "ignorePaths": [
    "deploy/**",
    "docker-compose*.yml",
    "docs/**",
    "kustomization.yaml"
  ],
  "packageRules": [
    {
      "description": "Dependencies baked into the published images must cut a release.",
      "matchFileNames": ["target/**"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Major bumps of shipped dependencies warrant a minor release.",
      "matchFileNames": ["target/**"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    },
    {
      "description": "swaks releases are dated, not semver.",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jetmore/swaks"],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile$/",
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "VER=(?<currentValue>.*?) # renovate: depName=(?<depName>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
